{
  "name": "@apps/iam",
  "version": "0.1.0",
  "private": true,
  "main": "dist/src/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "tsx ../../scripts/drizzle/create-migration.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@packages/common": "workspace:*",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "jose": "^6.2.12",
    "postgres": "^3.4.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "drizzle-kit": "^0.30.4"
  }
}

{
  "name": "media-delivery-system",
  "private": true,
  "scripts": {
    "build:dev": "pnpm -r run build",
    "start:dev": "pnpm -r --parallel run dev",
    "db:up:dev": "docker compose up -d postgres",
    "db:down:dev": "docker compose down",
    "db:generate:dev": "pnpm -r run db:generate",
    "db:migrate:dev": "pnpm -r run db:migrate",
    "db:push:dev": "pnpm -r run db:push",
    "db:studio:dev": "pnpm -r run db:studio",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "format:check": "pnpm -r run format:check",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0"
  }
}